# CUDA variant of the CPU image in ./Dockerfile.
#
# Not published to Docker Hub - build it locally:
#
#   docker build -f Dockerfile.gpu -t wyoming-qwen3-asr:gpu .
#
# NVIDIA only: the model runs on onnxruntime's CUDA execution provider. Jetson
# would need an nvcr.io/nvidia/l4t base and JetPack-specific onnxruntime wheels;
# that is a separate image, not a platform of this one.
#
# The base supplies cuBLAS and cuDNN 9, which onnxruntime-gpu links against. Run
# with `--gpus all` and the NVIDIA Container Toolkit installed on the host.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# onnxruntime-gpu on PyPI switched from CUDA 12 to CUDA 13 in 1.27.0 (1.26.0 is
# the last CUDA 12 build). Unpinned, it installs a wheel that wants
# libcublasLt.so.13 and quietly drops back to the CPU provider on this base.
ARG ONNXRUNTIME_GPU_VERSION=">=1.19,<1.27"

WORKDIR /usr/src

COPY ./pyproject.toml ./
RUN \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    \
    && python3 -m venv .venv \
    && .venv/bin/pip3 install --no-cache-dir -U \
        setuptools \
        wheel \
    && .venv/bin/pip3 install --no-cache-dir \
        -e '.[zeroconf,hass]' \
    \
    # The package depends on the CPU onnxruntime. onnxruntime-gpu installs the
    # same "onnxruntime" module, and whichever lands second wins - so remove the
    # CPU build and install the GPU one alone. Only pip's metadata is left
    # unhappy (`pip check` reports the missing CPU package); nothing at runtime
    # notices.
    && .venv/bin/pip3 uninstall -y onnxruntime \
    && .venv/bin/pip3 install --no-cache-dir "onnxruntime-gpu${ONNXRUNTIME_GPU_VERSION}" \
    \
    && rm -rf /var/lib/apt/lists/*

COPY ./ ./

# docker_run.sh reads STT_DEVICE; an explicit --device on the command line still
# wins, since user arguments are appended after it.
#
# HF_HOME/XDG_CACHE_HOME keep the library caches on the /data volume; see the
# CPU image for why they have to be set here and not in Python.
ENV STT_DEVICE=cuda \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/data \
    XDG_CACHE_HOME=/data

EXPOSE 10300

# See the CPU image for why this is a Describe/Info round trip and why the start
# period is this long.
HEALTHCHECK --interval=30s --timeout=20s --start-period=5m --retries=3 \
    CMD ["/usr/src/.venv/bin/python3", "-m", "wyoming_faster_whisper.health_check"]

ENTRYPOINT ["bash", "docker_run.sh"]
